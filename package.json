{
  "name": "tbh-core",
  "version": "0.0.1",
  "description": "Open-source Task Bar Hero telemetry and farming analytics companion.",
  "license": "MIT",
  "author": "iMagicKey",
  "type": "module",
  "main": "dist-electron/main.js",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "dist:win": "pnpm build && electron-builder --win nsis --x64",
    "release": "pnpm build && electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-electron": "1.1.2",
    "vitest": "5.0.1"
  },
  "build": {
    "appId": "io.github.imagickey.tbhcore",
    "productName": "TBH Core",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "artifactName": "TBH-Core-${version}-${arch}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "iMagicKey",
        "repo": "TBH-Core"
      }
    ]
  }
}
